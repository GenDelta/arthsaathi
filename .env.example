# Environment variable template for ArthSaathi.
# Copy this file to .env and fill in real values before running the app.
# DO NOT commit .env — it is listed in .gitignore.

# ─── JWT ───────────────────────────────────────────────────────────────────────
# A long, random secret string used to sign HS256 tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=replace-me-with-a-long-random-secret

# ─── LLM provider ──────────────────────────────────────────────────────────────
# Supported values: "ollama" | "openai" | "anthropic"
LLM_PROVIDER=ollama
LLM_MODEL_NAME=glm-5.3-flash

# ─── Ollama (used when LLM_PROVIDER=ollama) ────────────────────────────────────
OLLAMA_BASE_URL=https://ollama.ai

# ─── OpenAI / Anthropic (used when LLM_PROVIDER=openai or anthropic) ──────────
# LLM_API_KEY=sk-...

# ─── Database paths ────────────────────────────────────────────────────────────
# Paths are relative to the backend service working directory.
DATABASE_PATH=./arthsaathi.db
LANCEDB_PATH=./.lancedb

# ─── Tesseract ─────────────────────────────────────────────────────────────────
# Required only if Tesseract is not on PATH (Windows installs often need this).
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# ─── Application ───────────────────────────────────────────────────────────────
# Backend origin, used by the frontend API client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
